{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2024", "dom", "dom.iterable"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["./**/*.ts", "../domain/**/*.ts", "../protocol.ts"]
}
