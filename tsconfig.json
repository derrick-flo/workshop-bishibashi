{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": ["src/server", "src/domain", "src/protocol.ts", "test", "worker-configuration.d.ts"],
	// Node 서버 테스트는 Node 타입이 필요해서 src/node/tsconfig.json 에서 따로 검사한다
	"exclude": ["test/node"]
}
