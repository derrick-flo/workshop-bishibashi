{
	"name": "workshop-bishibashi",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"dev:lan": "wrangler dev --ip 0.0.0.0",
		"deploy": "wrangler deploy",
		"build:client": "esbuild src/client/player.ts src/client/host.ts --bundle --format=esm --target=es2022 --minify --sourcemap --outdir=public/js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
		"cf-typegen": "wrangler types",
		"rehearsal": "esbuild scripts/rehearsal.ts --bundle --platform=node --format=esm --outfile=.wrangler/rehearsal.mjs --log-level=warning && node .wrangler/rehearsal.mjs"
	},
	"devDependencies": {
		"esbuild": "^0.28.2",
		"qrcode-generator": "^2.0.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.152.0"
	}
}
