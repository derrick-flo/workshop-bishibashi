{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "workshop-bishibashi",
	"main": "src/server/index.ts",
	"compatibility_date": "2026-09-25",
	"workers_dev": true,
	"observability": {
		"enabled": true
	},
	// 폰 화면(index.html)·진행자 화면(host.html)·관전 화면(arena.html)은 정적 파일로 내려준다. /ws 만 Worker가 받는다.
	"assets": {
		"directory": "./public"
	},
	// 게임 한 판 전체를 Durable Object 하나("main")가 들고 있는다.
	"durable_objects": {
		"bindings": [{ "name": "GAME_ROOM", "class_name": "GameRoom" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
	// 브라우저용 코드(src/client)는 배포·개발 전에 esbuild로 묶어 public/js 에 둔다.
	"build": {
		"command": "npm run build:client",
		"watch_dir": "src"
	}
	// 진행자 키(HOST_KEY)는 여기 두지 않고 `wrangler secret put HOST_KEY`로 등록한다.
	// 내 컴퓨터·사내망 주소로 연 로컬 서버는 키 없이 들어간다(src/host-access.ts).
}
